.build/
ci/t/servroot/
ci/fuzz/fuzz_scan
ci/fuzz/fuzz_body
ci/fuzz/corpus-min/
ci/fuzz/crash-*
*.o
*.so

# libFuzzer writes newly-discovered units into the corpus dir at runtime.
# Only the curated, hand-named seeds belong in git; the rest are churn.
ci/fuzz/corpus/fuzz_scan/*
!ci/fuzz/corpus/fuzz_scan/[0-9][0-9]-*
ci/fuzz/corpus/fuzz_body/*
!ci/fuzz/corpus/fuzz_body/[0-9][0-9]-*

# Unit-test build output (ci/tests/unit/run.sh). The binary and its objects are
# rebuilt from source on every run; the .gcda/.gcno are coverage artifacts.
ci/tests/unit/test_scan
ci/tests/unit/*.o
ci/tests/unit/*.gcda
ci/tests/unit/*.gcno

# Compilation database, written by `bear -- ci/tools/ci-build.sh` in the
# security-scanners job so clang-tidy replays the build's real flags. Derived
# output, and it records absolute paths from the machine that built it -- a
# committed copy would send clang-tidy at someone else's directories.
compile_commands.json

# Python bytecode cache. ci/linter/workflow_policy.py is imported by its
# wrappers, so running the lint gate creates this; it is derived output, it is
# CPython-version-specific, and it carries an embedded source timestamp.
__pycache__/
*.pyc
